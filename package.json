{
  "name": "the-sea-right-now",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "node scripts/parallel.mjs \"tsc -p tsconfig.app.json --noEmit\" \"tsc -p tsconfig.worker.json --noEmit\" \"tsc -p tsconfig.node.json --noEmit\"",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "verify": "node scripts/parallel.mjs \"tsc -p tsconfig.app.json --noEmit\" \"tsc -p tsconfig.worker.json --noEmit\" \"tsc -p tsconfig.node.json --noEmit\" \"eslint .\" \"vitest run --project unit\"",
    "smoke": "playwright test --project=smoke",
    "smoke:webgpu": "playwright test --project=webgpu",
    "verify:all": "node scripts/verify-all.mjs",
    "snapshot:stations": "node scripts/build-station-snapshot.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260825.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
